# =============================================================================
# DistriPartner Platform - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
# =============================================================================

# -----------------------------------------------------------------------------
# Azure AI Foundry Configuration
# -----------------------------------------------------------------------------
# Your Azure AI Foundry project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://your-project.ai.azure.com

# -----------------------------------------------------------------------------
# Model Deployments
# -----------------------------------------------------------------------------
# Three tiers available for cost/capability optimization:
# - COMPLEX: For agents requiring advanced reasoning (Orchestrator, Profiler)
# - STANDARD: For moderate complexity agents (DataCollector)
# - SIMPLE: For straightforward tasks (Support, Ticketing, Communication)
#
# Recommended models:
# - gpt-4.1 or gpt-4o for COMPLEX
# - gpt-4.1-mini or gpt-4o-mini for STANDARD/SIMPLE
MODEL_DEPLOYMENT_COMPLEX=gpt-4.1
MODEL_DEPLOYMENT_STANDARD=gpt-4.1
MODEL_DEPLOYMENT_SIMPLE=gpt-4.1

# -----------------------------------------------------------------------------
# Azure AI Search Configuration (RAG)
# -----------------------------------------------------------------------------
# Used by Support agent for knowledge base retrieval
AZURE_AI_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_AI_SEARCH_KEY=your-search-admin-key
AZURE_AI_SEARCH_INDEX=your-search-index-name

# Azure Storage connection string (used by setup_ai_search.py)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=your-account;AccountKey=your-key

# -----------------------------------------------------------------------------
# MCP Server URLs
# -----------------------------------------------------------------------------
# Model Context Protocol servers for external tool integration
#
# Option 1: Unified MCP (all services through a single server)
# Option 2: Specialized MCPs (separate server per service domain)

# EntraID MCP - User profile and identity information
MCP_ENTRAID_URL=https://your-mcp.azurewebsites.net/mcp

# CosmosDB MCP - Subscription and tenant data
MCP_COSMOSDB_URL=https://your-mcp.azurewebsites.net/mcp

# Email MCP - Communication and notification service
MCP_EMAIL_URL=https://your-mcp.azurewebsites.net/mcp

# Microsoft Learn MCP (public, no auth required)
MCP_LEARN_URL=https://learn.microsoft.com/api/mcp

# -----------------------------------------------------------------------------
# MCP Connection Name
# -----------------------------------------------------------------------------
# Name of the MCP connection created in Azure AI Foundry portal
# This connection uses Microsoft Entra + Project Managed Identity authentication
#
# To create this connection:
# 1. Go to Azure AI Foundry portal
# 2. Navigate to Connections
# 3. Create a new MCP connection with your server URL
# 4. Use the connection name here
MCP_CONNECTION_NAME=AzureMCPTool
