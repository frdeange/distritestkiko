# =============================================================================
# DistriPartner Platform - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# All variables use placeholder values that need to be replaced.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
# =============================================================================

# -----------------------------------------------------------------------------
# Azure AI Foundry Configuration
# -----------------------------------------------------------------------------
# Your Azure AI Foundry project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://your-project.ai.azure.com

# -----------------------------------------------------------------------------
# Model Deployments
# -----------------------------------------------------------------------------
# Three tiers available for cost/capability optimization:
# - COMPLEX: For agents requiring advanced reasoning (Orchestrator)
# - STANDARD: For moderate complexity agents (Profiler, DataCollector)
# - SIMPLE: For straightforward tasks (Support, Ticketing, Communication)
#
# Recommended models:
# - gpt-4.1 or gpt-4o for COMPLEX
# - gpt-4.1-mini or gpt-4o-mini for STANDARD/SIMPLE
MODEL_DEPLOYMENT_COMPLEX=gpt-4.1
MODEL_DEPLOYMENT_STANDARD=gpt-4.1
MODEL_DEPLOYMENT_SIMPLE=gpt-4.1

# -----------------------------------------------------------------------------
# Azure AI Search Configuration (RAG)
# -----------------------------------------------------------------------------
# Used by Support agent for knowledge base retrieval
AZURE_AI_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_AI_SEARCH_KEY=your-search-admin-key

# Vector store ID for support knowledge base (created in Azure AI Foundry)
VECTOR_STORE_SUPPORT=vs_support_xxxxx

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------
# Model Context Protocol servers for external tool integration
# 
# Option 1: Unified MCP (current setup)
# All services exposed through a single MCP server
#
# Option 2: Specialized MCPs (future)
# Separate MCP servers per service domain

# MCP Server URL (unified Azure MCP)
MCP_COSMOSDB_URL=https://your-mcp.azurewebsites.net/mcp
MCP_ENTRAID_URL=https://your-mcp.azurewebsites.net/mcp
MCP_EMAIL_URL=https://your-mcp.azurewebsites.net/mcp

# Microsoft Learn MCP (public, no auth required)
MCP_LEARN_URL=https://learn.microsoft.com/api/mcp

# -----------------------------------------------------------------------------
# MCP Connection Name
# -----------------------------------------------------------------------------
# Name of the MCP connection created in Azure AI Foundry portal
# This connection uses Microsoft Entra + Project Managed Identity authentication
# 
# To create this connection:
# 1. Go to Azure AI Foundry portal
# 2. Navigate to Connections
# 3. Create a new MCP connection with your server URL
# 4. Use the connection name here
MCP_CONNECTION_NAME=AzureMCPTool

# -----------------------------------------------------------------------------
# CosmosDB Configuration (for Ticketing)
# -----------------------------------------------------------------------------
# Used by Ticketing agent to store support tickets
COSMOSDB_ACCOUNT=distriplatform-cosmos
COSMOSDB_DATABASE=distripartner
COSMOSDB_CONTAINER_TICKETS=tickets

# -----------------------------------------------------------------------------
# Azure Communication Services (for Email)
# -----------------------------------------------------------------------------
# Used by Ticketing and Communication agents for sending emails
ACS_CONNECTION_STRING=your-acs-connection-string
ACS_SENDER_EMAIL=DoNotReply@your-domain.azurecomm.net

# Support team email recipients
SUPPORT_EMAIL_RECIPIENTS=support@yourcompany.com

# -----------------------------------------------------------------------------
# Optional: PowerShell MCP (for CampaignManager - BACKLOG)
# -----------------------------------------------------------------------------
# Currently not implemented - CampaignManager is excluded from workflow
# MCP_POWERSHELL_URL=https://your-powershell-mcp.azurewebsites.net/mcp

# -----------------------------------------------------------------------------
# Optional: Ticketing API (alternative to CosmosDB storage)
# -----------------------------------------------------------------------------
# OpenAPI-based ticketing system for support case management
# TICKETING_API_SPEC_URL=https://your-ticketing-api.com/openapi.json
# TICKETING_API_KEY=your-ticketing-api-key
# TICKETING_API_ENDPOINT=https://your-ticketing-api.com/v1
